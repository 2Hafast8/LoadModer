{
  "name": "loadmoder",
  "version": "2.11.0",
  "description": "High-performance Minecraft mod & modpack manager CLI",
  "license": "MIT",
  "author": "Hafiz Noval rianto <https://github.com/2Hafast8>",
  "homepage": "https://github.com/2Hafast8/LoadModer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2Hafast8/LoadModer.git"
  },
  "bugs": {
    "url": "https://github.com/2Hafast8/LoadModer/issues"
  },
  "keywords": [
    "minecraft",
    "mod-manager",
    "modpack",
    "mrpack",
    "cli",
    "tui",
    "fabric",
    "forge",
    "neoforge",
    "quilt",
    "prism-launcher",
    "multimc",
    "tlauncher",
    "legacy-launcher"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "loadmoder": "./dist/index.js",
    "lm": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "desktop:build": "vite build --config vite.config.desktop.ts && tsup --config tsup.desktop.config.ts",
    "desktop:dev": "vite --config vite.config.desktop.ts",
    "desktop": "npm run desktop:build && tsx src/desktop/launcher.ts",
    "desktop:dist": "npm run desktop:build && electron-builder --win --publish never",
    "build:all": "npm run build && npm run desktop:build",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@inquirer/prompts": "^8.7.2",
    "archiver": "^8.0.0",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "p-limit": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "unzipper": "^0.12.3",
    "write-file-atomic": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.10",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
